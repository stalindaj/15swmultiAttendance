# Copy this file to ".env" in the app folder on the server (cPanel → File Manager) and fill in
# the CHANGE_ME values. Never commit the real .env.

APP_NAME="15SW Attendance"
APP_ENV=production
# Leave empty the first time: /install shows a key to paste here.
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# cPanel → MySQL Databases: create the database and a user, add the user to the database
# with ALL PRIVILEGES. cPanel prefixes both names with your account name (e.g. acct_attendance).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_attendance
DB_USERNAME=CHANGE_ME_attendance
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Online: the dashboard, roster and accounts open anywhere, behind the records login.
ATTENDANCE_ADMIN_LOCALHOST_ONLY=false

# First-time setup: put a long random value here, open https://your-site/install?token=THAT_VALUE,
# and delete the value again when setup is done.
INSTALL_TOKEN=
