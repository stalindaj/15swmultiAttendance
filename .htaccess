# LOAD-BEARING — never delete. On this hosting the whole app folder (including .env) sits inside
# public_html. The domain's document root must be the public/ folder; this file makes sure that
# nothing else in the app folder can ever be fetched from the web (e.g. via the main domain).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public(/|$)) - [F,L]
</IfModule>

<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>
